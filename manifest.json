{
  "manifest_version": 2,
  "name": "PQC Thunderbird Extension",
  "version": "1.0",
  "description": "Post-quantum encryption and digital signatures",
  "applications": {
    "gecko": {
      "id": "pqcmail@mydomain.com",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "storage",
    "compose",
    "messagesRead",
    "activeTab"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_popup": "dialogs/browser_ui.html",
    "default_title": "BB PQC Security"
  },
  "compose_action": {
    "default_popup": "dialogs/compose_ui.html",
    "default_title": "Mail Security"
  },
  "message_display_action": {
    "default_popup": "dialogs/message_display_ui.html",
    "default_title": "Decryption"
  },
  "options_ui": {
    "page": "options/keystore_ui.html",
    "open_in_tab": true
  }
}